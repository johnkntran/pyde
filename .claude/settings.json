{
  "permissions": {
    "deny": [
      "Read(**/.env)",
      "Edit(**/.env)",
      "Read(**/.env.local)",
      "Edit(**/.env.local)",
      "Read(**/devcontainer.env)",
      "Edit(**/devcontainer.env)"
    ]
  },
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/claude-emit-turn-to-github.sh",
            "timeout": 30,
            "statusMessage": "Mirroring conversation turn to GitHub issue…"
          }
        ]
      }
    ]
  }
}
